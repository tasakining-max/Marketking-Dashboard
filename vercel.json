{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/uploads/(.*)", "dest": "/public/uploads/$1" },
    { "src": "/(.*\\.(js|css|html|png|jpg|webp|gif|ico|svg))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}
