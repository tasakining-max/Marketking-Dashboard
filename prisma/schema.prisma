generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Card {
  id                 String   @id @default(uuid())
  title              String
  description        String   @default("")
  column             String   @default("idea")
  status             String   @default("active")
  rejectionReason    String   @default("")
  tags               String[] @default([])
  platforms          String[] @default([])
  imageUrl           String?  @db.Text
  todos              Json     @default("[]")
  issues             Json     @default("[]")
  comments           Json     @default("[]")
  links              Json     @default("[]")
  order              Float    @default(0)
  pinned             Boolean  @default(false)
  plannedPublishDate String?
  publishedAt        String?
  shootDate          String?
  shootNote          String   @default("")
  caption            String   @default("") @db.Text
  linkedVideoId      String?
  videoUrl           String?
  videoMimeType      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model KeyMessage {
  id   String @id @default(uuid())
  text String
}

model Profile {
  id       String @id @default(uuid())
  name     String @unique
  imageUrl String @db.Text
}

model ActivityEntry {
  id        String   @id @default(uuid())
  text      String
  createdAt DateTime @default(now())
}

model CronJob {
  id       String  @id @default(uuid())
  name     String
  schedule String
  command  String
  enabled  Boolean @default(true)
}

model WebsiteIssue {
  id      String @id
  date    String
  feature String
  issues  Json   @default("[]")
}

model MarketingChangelog {
  id        String   @id @default(uuid())
  text      String
  date      DateTime @default(now())
}

model WebsiteChangelog {
  id        String   @id @default(uuid())
  text      String
  date      DateTime @default(now())
}

model AdInsight {
  id               String   @id @default(uuid())
  date             DateTime
  campaignName     String
  spend            Float    @default(0)
  reach            Int      @default(0)
  impressions      Int      @default(0)
  clicks           Int      @default(0)
  ctr              Float    @default(0)
  cpc              Float    @default(0)
  targetAudience   String   @default("")
  creativeName     String   @default("")
  creativeImageUrl String?  @db.Text
  createdAt        DateTime @default(now())
}

model AutoPostLog {
  id           String   @id @default(uuid())
  cardId       String?
  cardTitle    String
  platform     String
  placement    String   @default("Feed")
  status       String   @default("success")
  postUrl      String?  @db.Text
  errorMessage String?  @db.Text
  postedAt     DateTime @default(now())
}

model PageVideoInsight {
  id            String   @id @default(uuid())
  videoId       String   @unique
  description   String   @default("") @db.Text
  createdTime   DateTime
  length        Float    @default(0)
  permalinkUrl  String   @default("") @db.Text
  views         Int      @default(0)
  postViews     Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  shares        Int      @default(0)
  fetchedAt     DateTime @default(now())
}
