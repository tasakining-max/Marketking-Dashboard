generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Card {
  id                 String   @id @default(uuid())
  title              String
  description        String   @default("")
  column             String   @default("idea")
  status             String   @default("active")
  rejectionReason    String   @default("")
  tags               String[] @default([])
  platforms          String[] @default([])
  imageUrl           String?  @db.Text
  todos              Json     @default("[]")
  issues             Json     @default("[]")
  comments           Json     @default("[]")
  links              Json     @default("[]")
  order              Float    @default(0)
  pinned             Boolean  @default(false)
  plannedPublishDate String?
  scheduledPublishAt String?
  publishedAt        String?
  shootDate          String?
  shootNote          String   @default("")
  caption            String   @default("") @db.Text
  linkedVideoId      String?
  videoUrl           String?
  videoMimeType      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model GraphicDesignCard {
  id          String   @id @default(uuid())
  title       String
  description String   @default("")
  column      String   @default("todo")
  usage       String[] @default([])
  imageUrl    String?  @db.Text
  comments    Json     @default("[]")
  order       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KeyMessage {
  id   String @id @default(uuid())
  text String
}

model Profile {
  id       String @id @default(uuid())
  name     String @unique
  imageUrl String @db.Text
}

// Last time a given profile (person) had a given dashboard tab open — one
// row per profile+page, overwritten on every visit. Powers a "when did X
// last check this tab" panel; not a full visit history/audit log.
model TabView {
  id          String   @id @default(uuid())
  profileName String
  page        String
  viewedAt    DateTime @default(now())

  @@unique([profileName, page])
}

model ActivityEntry {
  id        String   @id @default(uuid())
  text      String
  createdAt DateTime @default(now())
}

model CronJob {
  id       String  @id @default(uuid())
  name     String
  schedule String
  command  String
  enabled  Boolean @default(true)
}

model WebsiteIssue {
  id      String @id
  date    String
  feature String
  issues  Json   @default("[]")
}

model MarketingChangelog {
  id        String   @id @default(uuid())
  text      String
  date      DateTime @default(now())
}

model WebsiteChangelog {
  id        String   @id @default(uuid())
  text      String
  date      DateTime @default(now())
}

model AdInsight {
  id               String   @id @default(uuid())
  date             DateTime
  adId             String   @default("")
  campaignName     String
  spend            Float    @default(0)
  reach            Int      @default(0)
  impressions      Int      @default(0)
  clicks           Int      @default(0)
  ctr              Float    @default(0)
  cpc              Float    @default(0)
  targetAudience   String   @default("")
  creativeName     String   @default("")
  creativeImageUrl String?  @db.Text
  createdAt        DateTime @default(now())

  @@unique([date, adId])
}

model AutoPostLog {
  id           String   @id @default(uuid())
  cardId       String?
  cardTitle    String
  platform     String
  placement    String   @default("Feed")
  status       String   @default("success")
  postUrl      String?  @db.Text
  errorMessage String?  @db.Text
  postedAt     DateTime @default(now())
}

model AdActionLog {
  id        String   @id @default(uuid())
  text      String   @db.Text
  method    String   @default("")
  createdAt DateTime @default(now())
}

// ─── Competitor Watch ("ส่องคู่แข่ง") ──────────────────────────────────────
// section: 'meta_ads' (active Facebook ad count per brand) | 'ai_search'
// (whether the brand's site blocks AI crawlers in robots.txt)
model CompetitorMetric {
  id         String   @id @default(uuid())
  section    String
  brand      String
  value      String   @default("")
  score      Int?
  note       String   @default("") @db.Text
  verified   Boolean  @default(false)
  checkedAt  DateTime @default(now())

  @@index([section])
}

// Freeform log for the Website/SEO section (Google Ads + organic SEO keyword
// findings) — inherently qualitative, so kept as notes rather than structured
// metrics like the other two sections.
model CompetitorSeoNote {
  id        String   @id @default(uuid())
  text      String   @db.Text
  createdAt DateTime @default(now())
}

// Checklist of 30 target keywords for tasaki.co.th's organic/paid Google
// presence — since Google blocks automated checking (see ส่องคู่แข่ง page
// notes), the checkmarks are filled in by hand after a real browser search.
model SeoKeyword {
  id          String    @id @default(uuid())
  keyword     String
  category    String    @default("")
  organic     Boolean   @default(false)
  ads         Boolean   @default(false)
  note        String    @default("") @db.Text
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  checkedAt   DateTime?
}

// "แผนเว็บไซต์เป็นอันดับ 1" 1-month sprint to-do list (see the ส่องคู่แข่ง
// competitive report this was derived from). phase groups items into weeks.
model WebsiteTodo {
  id        String    @id @default(uuid())
  phase     String
  text      String    @db.Text
  done      Boolean   @default(false)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  doneAt    DateTime?
}

model PageVideoInsight {
  id            String   @id @default(uuid())
  videoId       String   @unique
  description   String   @default("") @db.Text
  createdTime   DateTime
  length        Float    @default(0)
  permalinkUrl  String   @default("") @db.Text
  views         Int      @default(0)
  postViews     Int      @default(0)
  // Video-view count attributed to a Facebook ad promoting this exact video
  // (matched via the ad's creative.video_id) — 0 for videos with no ad
  // running against them. `views` above is the total across all sources;
  // organic = views - adViews. See scripts/sync-video-ad-views.mjs.
  adViews       Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  shares        Int      @default(0)
  fetchedAt     DateTime @default(now())
}
