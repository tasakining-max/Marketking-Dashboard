{
  "name": "marketing-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local dashboard for tracking marketing content: Idea Content -> Short Clip -> Published",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "migrate": "node scripts/migrate-to-neon.mjs",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vercel/blob": "^2.5.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "ws": "^8.21.0"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "prisma@7.8.0": true
  }
}
